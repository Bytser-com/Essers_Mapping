# ==============================================================================
# H.Essers Mapping Platform - Unified Local & Multi-Service Environment
#
# Usage:
#   source .env
#   (or: source ../.env when running from a service directory)
#
# All variables use 'export' so sourcing this file exports them into the
# shell environment and makes them immediately available to subprocesses
# (Python/Uvicorn, Spring Boot/Maven, Vite/Node, Docker Compose, Playwright).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Common Configuration
# ------------------------------------------------------------------------------
export TZ="Europe/Brussels"
export LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. AI & LLM Service Configuration (Mapping_Proposal)
# ------------------------------------------------------------------------------
# Insert your Gemini API Key here (keep empty for basic tests/status tracking)
export GEMINI_API_KEY=""
export GEMINI_MODEL="gemini-3.5-flash-lite"
export GEMINI_TIMEOUT_MS="120000"
export AI_LIMIT_TARGETS="10"

# Upload watcher & directory settings:
export INCOMING_DIR="/tmp/source"

# Allowed browser origins for local development
export CORS_ORIGINS="http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. Shared SFTP Storage (Mapping_Proposal, Version_Control, sftp-shared)
# ------------------------------------------------------------------------------
# Host & authentication
export SFTP_SHARED_HOST="localhost"
export SFTP_SHARED_PORT="2222"
export SFTP_SHARED_USER="shareduser"
export SFTP_SHARED_PASSWORD="devpassword"
export SFTP_ALLOW_UNKNOWN_KEYS="true"

# Remote directories on sftp-shared (both standard and descriptive aliases):
export SFTP_SHARED_PROPOSALS_DIR="/Proposals"
export SFTP_SHARED_PACKAGES_DIR="/Packages"

# Backward-compatible aliases for Version_Control (application.properties):
export SFTP_HOST="localhost"
export SFTP_PORT="2222"
export SFTP_USER="shareduser"
export SFTP_PASSWORD="devpassword"
export SFTP_BASE_PATH="/Proposals"

# ------------------------------------------------------------------------------
# 4. Runtime SFTP Storage (Runtime Backend, sftp-runtime)
# ------------------------------------------------------------------------------
export SFTP_RUNTIME_HOST="localhost"
export SFTP_RUNTIME_PORT="2223"
export SFTP_RUNTIME_USER="runtimeuser"
export SFTP_RUNTIME_PASSWORD="devpassword"

# Remote directories on sftp-runtime (both standard and descriptive aliases):
export SFTP_RUNTIME_REMOTE_DIR="/Packages"
export SFTP_RUNTIME_PACKAGES_DIR="/Packages"
export SFTP_SHARED_PACKAGES_DIR="/Packages"

# ------------------------------------------------------------------------------
# 5. SFTPGo Admin Credentials (Scripts/docker-compose.sftp.yml)
# ------------------------------------------------------------------------------
export SFTPGO_DEFAULT_ADMIN_USERNAME="admin"
export SFTPGO_DEFAULT_ADMIN_PASSWORD="devpassword"

# ------------------------------------------------------------------------------
# 6. Service HTTP Ports & Internal Endpoints
# ------------------------------------------------------------------------------
# Version Control Service HTTP port (mapped by Frontend proxy: /api/version-control -> 8085)
export SERVER_PORT="8085"

# Runtime Backend HTTP port
export RUNTIME_SERVER_PORT="8080"

# Inter-service URLs (Kubernetes parity / local service mesh)
export MAPPING_PROPOSAL_URL="http://localhost:8000"
export MAPPING_CONVERTER_URL="http://localhost:8000"
export VERSION_CONTROL_BACKEND_URL="http://localhost:8085"
export RUNTIME_BACKEND_URL="http://localhost:8080"

# ------------------------------------------------------------------------------
# 7. Frontend & E2E Testing (Frontend)
# ------------------------------------------------------------------------------
export PLAYWRIGHT_BASE_URL="http://127.0.0.1:4173"
export PLAYWRIGHT_SKIP_WEBSERVER="1"
