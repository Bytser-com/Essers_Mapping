---
profile: production

exclude_paths:
  - .cache/
  - .github/

skip_list:
  - yaml[line-length]
  # Inventories and cooperating roles share public security_*, runner_* and
  # k8s_* variables. Skip the role-prefix convention for this configuration API;
  # all other variable naming, syntax, module and argument checks remain enabled.
  - var-naming[no-role-prefix]
