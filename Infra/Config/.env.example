# ==============================================================================
# ANSIBLE CONFIGURATION ENVIRONMENT VARIABLES (.env.example)
# Usage:
#   cp .env.example .env
#   # Fill in your values in .env, then load them into your shell:
#   source .env
# ==============================================================================

# --- 1. VM SSH & Sudo Authentication ---
# Must match the cloud-init user configured in Infra/Setup/terraform.tfvars
export DEBIAN_VM_USERNAME="sysadmin"
export DEBIAN_VM_USER_PASSWORD="<<PASSWORD>>"

# SSH Private Key (choose Option A OR Option B):
# Option A: Path to your local SSH private key file on disk
export SSH_PRIVATE_KEY_FILE="$HOME/.ssh/id_ed25519"

# Option B: Raw SSH private key content (matches GitHub Actions secret PIPELINE_SSH_PRIVATE_KEY)
# Leave empty locally if using Option A above; in CI/CD or if pasted below, sourcing .env
# writes the key to .cache/id_pipeline (0600) and sets ANSIBLE_PRIVATE_KEY_FILE automatically.
export PIPELINE_SSH_PRIVATE_KEY=""

if [ -n "${PIPELINE_SSH_PRIVATE_KEY:-}" ]; then
  mkdir -p .cache
  printf '%s\n' "$PIPELINE_SSH_PRIVATE_KEY" > .cache/id_pipeline
  chmod 600 .cache/id_pipeline
  export ANSIBLE_PRIVATE_KEY_FILE="$PWD/.cache/id_pipeline"
elif [ -n "${SSH_PRIVATE_KEY_FILE:-}" ]; then
  export ANSIBLE_PRIVATE_KEY_FILE="$SSH_PRIVATE_KEY_FILE"
fi

# --- 2. Network & Host IPv4 Addresses (REQUIRED - Fails fast if missing) ---
# Plain IPv4 (e.g. 192.168.0.10) or CIDR (e.g. 192.168.0.10/24) are both supported
export IPV4_GATEWAY="192.168.0.1"
export K8S_MASTER_VM_IPV4_ADDRESS="192.168.0.10"
export K8S_WORKER_VM_IPV4_ADDRESS="192.168.0.11"
export PIPELINE_RUNNER_VM_IPV4_ADDRESS="192.168.0.12"

# --- 3. Host FQDNs (REQUIRED - Used for /etc/hosts & K8s API server SANs) ---
export K8S_MASTER_VM_DNS_DOMAIN="k8s-masterserver.essers.lan"
export K8S_WORKER_VM_DNS_DOMAIN="k8s-workerserver.essers.lan"
export PIPELINE_RUNNER_VM_DNS_DOMAIN="pipeline-runner.essers.lan"

# --- 4. GitHub Actions Runner Registration (Required when running runner tags) ---
export GH_REPO_URL="https://github.com/Bytser-com/Essers_Mapping"
# Personal Access Token (PAT) used by Ansible to dynamically request a short-lived
# runner registration token via the GitHub REST API:
export RUNNER_REGISTRATION_PAT="<<GITHUB_PAT>>"
export RUNNER_LABEL="testing" # e.g. "testing" or "production"
