# --- Inside your encrypted .env file ---

# Proxmox configuration
export TF_VAR_proxmox_api_url="https://192.168.0.10:8006/api2/json"
export TF_VAR_proxmox_api_token="svc-terraform-prod@pve!Terra_Prod=<<TOKEN>>"
export TF_VAR_proxmox_ssh_password="<<PASSWORD>>"

# VM configuration
export TF_VAR_debian_vm_user_password="<<PASSWORD>>"
export TF_VAR_pipeline_ssh_public_key="ssh-ed25519 <<SSH_KEY>>"

# Variables
export TF_VAR_node01_name="ProxVE-<<NODE_ID>>"

export TF_VAR_debian_cloud_image_url="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2"
export TF_VAR_debian_cloud_image_checksum="<<IMAGE_CHECKSUM>>"

export TF_VAR_ipv4_gateway="192.168.0.1"
export TF_VAR_pipeline_runner_vm_dns_domain="<<HOSTNAME_FQDN>>"
export TF_VAR_pipeline_runner_vm_ipv4_address="192.168.0.12"
export TF_VAR_k8s_master_vm_dns_domain="<<HOSTNAME_FQDN>>"
export TF_VAR_k8s_master_vm_ipv4_address="192.168.0.10"
export TF_VAR_k8s_worker_vm_dns_domain="<<HOSTNAME_FQDN>>"
export TF_VAR_k8s_worker_vm_ipv4_address="192.168.0.11"