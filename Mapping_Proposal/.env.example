# ==============================================================================
# Essers Mapping Proposal Service - Environment Configuration Example
# ==============================================================================
# Copy to Mapping_Proposal/.env and fill in your local credentials.
# Do not commit .env or real API keys. CI should use managed secrets.

# Gemini AI configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=120000
# Maximum attempts for each individual Gemini API request
GEMINI_MAX_ATTEMPTS=20

# Automatic frontend uploads (CLI defaults are independent)
# 0 = process all target fields
AI_LIMIT_TARGETS=10
AI_SOURCE_SAMPLES=3
AI_HISTORY_PAIRS=1
AI_BATCH_SIZE=10

# Whole-job retries after temporary errors (e.g. 429, 503, timeouts)
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_DELAY_SECONDS=30
AI_RETRY_MAX_DELAY_SECONDS=300

# Shared SFTP server (local Docker Compose: essers-sftp-shared)
SFTP_SHARED_HOST=localhost
SFTP_SHARED_PORT=2222
SFTP_SHARED_USER=shareduser
# Local Docker Compose uses devpassword; enter it in .env, not here.
SFTP_SHARED_PASSWORD=
# IMPORTANT: Python config reads SFTP_SHARED_PROPOSALS_DIR, not REMOTE_DIR.
SFTP_SHARED_PROPOSALS_DIR=/Proposals

# Frontend development
CORS_ORIGINS=http://localhost:5173

# Automatically process incoming XML uploads (1=enabled, 0=disabled)
WATCH_INCOMING=1
