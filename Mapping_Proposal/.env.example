# ==============================================================================
# Essers Mapping Proposal Service - Environment Configuration Example
# ==============================================================================

# Gemini API Key (optional for basic ingestion/status tracking, required for AI mapping generation)
GEMINI_API_KEY=

# Shared SFTP Server (sftp-shared container / Kubernetes)
SFTP_SHARED_HOST=localhost
SFTP_SHARED_PORT=2222
SFTP_SHARED_USER=shareduser
SFTP_SHARED_PASSWORD=devpassword
SFTP_SHARED_REMOTE_DIR=/Proposals

# CORS Origins for local Frontend development
CORS_ORIGINS=http://localhost:5173
