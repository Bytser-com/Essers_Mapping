# ==============================================================================
# H.Essers Mapping Platform - Unified Local & Multi-Service Environment
#
# Usage:
#   source .env
#   (or: source ../.env when running from a service directory)
#
# All variables use 'export' so sourcing this file exports them into the
# shell environment and makes them immediately available to subprocesses
# (Python/Uvicorn, Spring Boot/Maven, Vite/Node, Docker Compose, Playwright).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Common Configuration
# ------------------------------------------------------------------------------
export TZ="Europe/Brussels"
export LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. AI & LLM Service Configuration (Mapping_Proposal)
# ------------------------------------------------------------------------------
# Insert your Gemini API Key here (keep empty for basic tests/status tracking)
export GEMINI_API_KEY=""
export GEMINI_MODEL="gemini-3.5-flash-lite"
export GEMINI_TIMEOUT_MS="120000"
export AI_LIMIT_TARGETS=0
export AI_SOURCE_SAMPLES=5
export AI_HISTORY_PAIRS=2
export AI_BATCH_SIZE=10
export GEMINI_MAX_ATTEMPTS=20

# Retry entire upload after temporary failures
export AI_RETRY_MAX_ATTEMPTS=3
export AI_RETRY_DELAY_SECONDS=30
export AI_RETRY_MAX_DELAY_SECONDS=300

# Upload watcher & directory settings:
export INCOMING_DIR="/tmp/source"

# Allowed browser origins for local development
export CORS_ORIGINS="http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. Shared SFTP Storage (Mapping_Proposal, Version_Control, sftp-shared)
# ------------------------------------------------------------------------------
# Host & authentication
export SFTP_SHARED_HOST="localhost"
export SFTP_SHARED_PORT="2222"
export SFTP_SHARED_USER="shareduser"
export SFTP_SHARED_PASSWORD=""
export SFTP_ALLOW_UNKNOWN_KEYS="true"

# Remote directories on sftp-shared (both standard and descriptive aliases):
export SFTP_SHARED_PROPOSALS_DIR="/Proposals"


