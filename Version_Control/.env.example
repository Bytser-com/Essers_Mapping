# ==============================================================================
# Essers Version Control Service - Environment Configuration Example
#
# Copy this file to '.env' or export these variables in your shell environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# HTTP Server Configuration
# ------------------------------------------------------------------------------
# Port on which the Spring Boot application listens for incoming HTTP requests.
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# SFTP Fileshare Connection Settings
# ------------------------------------------------------------------------------
# Hostname or IP address of the SFTP server (e.g., sftp-shared in Kubernetes or localhost locally).
SFTP_SHARED_HOST=localhost

# SSH/SFTP port of the SFTP server.
SFTP_SHARED_PORT=22

# Username used to authenticate with the SFTP server.
SFTP_SHARED_USER=sftpuser

# Password used to authenticate with the SFTP server.
SFTP_SHARED_PASSWORD=sftppass

# Base directory on the remote SFTP share where proposal files are stored.
# Follows the structure: <base-path>/<Company>/<version>/<file>
SFTP_SHARED_REMOTE_DIR=/Proposals

# Whether to accept unverified SSH server host keys (true for dev/testing, false for strict production).
SFTP_ALLOW_UNKNOWN_KEYS=true
